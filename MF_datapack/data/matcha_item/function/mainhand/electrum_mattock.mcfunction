# processing enchantment matcha:warding_1 / warding_1 
execute store result score enchantsLvl warding_1 run data get storage matcha_item:enchants held.'matcha:warding_1'
execute unless score enchantsLvl warding_1 matches 1.. run data merge storage matcha_item:enchants held {matcha:warding_1: 1}
