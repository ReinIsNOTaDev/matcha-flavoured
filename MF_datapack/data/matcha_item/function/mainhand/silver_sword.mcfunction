# processing enchantment minecraft:smite / smite 
execute store result score enchantsLvl smite run data get storage matcha_item:enchants held.'minecraft:smite'
execute unless score enchantsLvl smite matches 3.. run data modify storage matcha_item:enchants held merge value {minecraft:smite: 3}
# processing enchantment matcha:warding_1 / warding_1 
execute store result score enchantsLvl warding_1 run data get storage matcha_item:enchants held.'matcha:warding_1'
execute unless score enchantsLvl warding_1 matches 1.. run data modify storage matcha_item:enchants held merge value {matcha:warding_1: 1}
